{
  "name": "@haneoka/tomori-ournotes-bot",
  "version": "0.1.0",
  "description": "Tomori Our Notes bot: public queries for QQ and serverless hosts",
  "type": "module",
  "license": "MPL-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/haneoka-gakuen/tomori-ournotes-bot.git"
  },
  "homepage": "https://github.com/haneoka-gakuen/tomori-ournotes-bot#readme",
  "sideEffects": false,
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "examples"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./qflare": {
      "types": "./dist/qflare.d.ts",
      "import": "./dist/qflare.js"
    },
    "./worker-adapter": {
      "types": "./dist/worker-adapter.d.ts",
      "import": "./dist/worker-adapter.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "prepack": "npm run build",
    "check": "npm run typecheck && npm run build"
  },
  "devDependencies": {
    "typescript": "^6.0.3"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=22"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bugs": {
    "url": "https://github.com/haneoka-gakuen/tomori-ournotes-bot/issues"
  },
  "packageManager": "pnpm@11.14.0"
}
